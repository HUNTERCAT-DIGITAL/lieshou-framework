<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.7</version>
    <relativePath/>
  </parent>

  <groupId>cn.huntercat</groupId>
  <artifactId>lieshou-framework</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>lieshou-framework</name>
  <description>猎手云产品线核心框架（lieshou-boot 单体 / lieshou-cloud 微服务 共同上游·同源唯一）</description>

  <modules>
    <module>framework-jwt</module>
    <module>framework-common</module>
    <module>framework-domain</module>
    <module>framework-service</module>
    <module>framework-approval</module>
    <module>framework-rules</module>
    <module>framework-auth</module>
    <module>framework-i18n</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <jjwt.version>0.12.6</jjwt.version>
  </properties>


  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>cn.huntercat</groupId>
        <artifactId>framework-jwt</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.huntercat</groupId>
        <artifactId>framework-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.huntercat</groupId>
        <artifactId>framework-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.huntercat</groupId>
        <artifactId>framework-service</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.huntercat</groupId>
        <artifactId>framework-approval</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.huntercat</groupId>
        <artifactId>framework-rules</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.huntercat</groupId>
        <artifactId>framework-auth</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- Spotless: Java 代码格式化与导入顺序（与各消费方一致） -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>2.43.0</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <style>GOOGLE</style>
            </googleJavaFormat>
            <removeUnusedImports/>
            <importOrder>
              <order>org.springframework,org.springframework.cloud,com.alibaba.cloud,jakarta,org,com,lombok,\#</order>
            </importOrder>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>