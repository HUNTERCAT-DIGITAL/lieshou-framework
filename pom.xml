<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.7</version>
    <relativePath/>
  </parent>

  <groupId>cn.huntercat</groupId>
  <artifactId>lieshou-framework</artifactId>
  <version>0.3.5</version>
  <packaging>pom</packaging>
  <name>lieshou-framework</name>
  <description>猎手云产品线核心框架（lieshou-boot 单体 / lieshou-cloud 微服务 共同上游·同源唯一）</description>

  <modules>
    <module>framework-parent</module>
    <module>framework-ai</module>
    <module>framework-jwt</module>
    <module>framework-common</module>
    <module>framework-domain</module>
    <module>framework-service</module>
    <module>framework-approval</module>
    <module>framework-rules</module>
    <module>framework-auth</module>
    <module>framework-i18n</module>
  </modules>

  <!-- 制品分发：内网 Nexus（见 /srv/nexus/README.md）。凭证只存在于 GitLab CI 变量，不落仓库。 -->
  <distributionManagement>
    <repository>
      <id>nexus</id>
      <name>Nexus maven-releases</name>
      <url>https://nexus.ts.huntercat.cn/repository/maven-releases/</url>
    </repository>
    <snapshotRepository>
      <id>nexus</id>
      <name>Nexus maven-snapshots</name>
      <url>https://nexus.ts.huntercat.cn/repository/maven-snapshots/</url>
    </snapshotRepository>
  </distributionManagement>

  <properties>
    <java.version>21</java.version>
    <spotless.version>2.43.0</spotless.version>
    <jjwt.version>0.12.6</jjwt.version>
  </properties>


  <dependencyManagement>
    <!-- ⚠️ 本清单与 framework-parent/pom.xml 的 framework-* 清单必须逐条同步：
         本清单服务于 framework 模块自身（各子模块的 NO-VERSION 依赖靠它兜底）；
         framework-parent/pom.xml 服务于 10 个服务仓。改一处必须改另一处。 -->
    <dependencies>
      <dependency>
        <groupId>cn.huntercat</groupId>
        <artifactId>framework-ai</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.huntercat</groupId>
        <artifactId>framework-jwt</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.huntercat</groupId>
        <artifactId>framework-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.huntercat</groupId>
        <artifactId>framework-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.huntercat</groupId>
        <artifactId>framework-service</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.huntercat</groupId>
        <artifactId>framework-approval</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.huntercat</groupId>
        <artifactId>framework-rules</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.huntercat</groupId>
        <artifactId>framework-auth</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.huntercat</groupId>
        <artifactId>framework-i18n</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>

      <!--
        发布 sources jar：消费方删掉 framework submodule 后，IDE 里仍需能跳进 framework 源码。
        发布 to Nexus 后消费方用 mvn dependency:sources 即可（等价于原先 submodule 的源码可读）。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
            <phase>package</phase>
          </execution>
        </executions>
      </plugin>
      <!-- Spotless: Java 代码格式化与导入顺序（与各消费方一致） -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <style>GOOGLE</style>
            </googleJavaFormat>
            <removeUnusedImports/>
            <importOrder>
              <order>org.springframework,org.springframework.cloud,com.alibaba.cloud,jakarta,org,com,lombok,\#</order>
            </importOrder>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>